*.npy *.npz *.parquet *.pickle
*.pt *.pth *.safetensors *.bin *.onnx *.pb
*.so *.so.* *.whl *.egg
*.jpg *.png *.jpeg
*.sqlite
*.wav *.ogg *.flac

